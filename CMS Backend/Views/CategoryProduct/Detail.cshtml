@model CMS.Data.Entities.CategoryProduct

@{
    Layout = "_LayoutAdmin";
}

<h3>Chi tiết danh mục sản phẩm</h3>

<table class="table table-bordered">

    <tr>
        <th>ID</th>
        <td>@Model.Id</td>
    </tr>

    <tr>
        <th>Tên danh mục</th>
        <td>@Model.Name</td>
    </tr>

    <tr>
        <th>Mô tả</th>
        <td>@Model.Description</td>
    </tr>

</table>

<a asp-action="Index" class="btn btn-secondary">
    Quay lại
</a>