@model CMS.Data.Entities.Order

@{
    ViewData["Title"] = "Cập nhật đơn hàng";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header">
            Cập nhật trạng thái đơn hàng
        </div>

        <div class="card-body">

            <form asp-action="Edit">

                <input type="hidden"
                       asp-for="Id" />

                <div class="mb-3">

                    <label class="form-label">
                        Trạng thái
                    </label>

                    <select asp-for="Status"
                            class="form-select">

                        <option value="0">
                            Chờ xử lý
                        </option>

                        <option value="1">
                            Đã xác nhận
                        </option>

                        <option value="2">
                            Hoàn thành
                        </option>

                        <option value="3">
                            Đã hủy
                        </option>

                    </select>

                </div>

                <button type="submit"
                        class="btn btn-success">
                    Lưu
                </button>

            </form>

        </div>

    </div>

</div>
</div>