@model IEnumerable<CMS.Data.Entities.Customer>
    @{
    Layout = "_LayoutAdmin";
    }

    <div class="container mt-4">

        <h2 class="mb-4 text-success">
            DANH SÁCH KHÁCH HÀNG
        </h2>

        <table class="table table-bordered table-hover shadow-sm">

            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Họ Tên</th>
                    <th>Email</th>
                    <th>Số Điện Thoại</th>
                    <th>Địa Chỉ</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                <tr>

                    <td>@item.Id</td>

                    <td>@item.FullName</td>

                    <td>@item.Email</td>

                    <td>@item.Phone</td>

                    <td>@item.Address</td>

                </tr>
                }

            </tbody>

        </table>

    </div>
